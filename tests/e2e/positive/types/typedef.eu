typedef MyInt as int;
typedef MyFloat as float;

typedef
    Foo as int,
    Bar as char,
    Baz as struct { int x; };

alias ConstChar = const char;
typedef String as ConstChar[];

int main() {
    MyInt myint = 10;
    int anotherint = 20;
    myint = anotherint as MyInt;

    if (myint != 20)
        return 1;

    MyFloat myfp = 3.14;
    float anotherfp = 1.12;
    anotherfp = myfp as float;

    if (anotherfp != 3.14)
        return 2;

    String s = "Hello";
    const char[] sslice = s as const char[];
    if (sslice[0] != 'H' || s[1] != 'e' || sslice[2] != 'l')
        return 3;

    Foo foo = 42;
    Bar bar = 'a';
    Baz baz = { .x = foo as int };
    if (foo != 42 || bar != 'a' || baz.x != 42)
        return 4;

    return 0;
}
